# Copy this file to .streamlit/secrets.toml and replace every placeholder.
# Never commit the real secrets.toml file.

[auth]
# Must exactly match the redirect URI registered in your Google OAuth client.
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_SECRET"
client_id = "YOUR_GOOGLE_CLIENT_ID"
client_secret = "YOUR_GOOGLE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[app_auth]
# Only verified Google emails listed here may access the dashboard.
allowed_emails = ["you@example.com"]
